{
  "name": "dsh-image-gen",
  "version": "0.2.0",
  "description": "Image generation plugin for DeepSeek Harness that calls gpt-image-2 through any OpenAI Images compatible endpoint, with in-conversation previews and a configurable settings card.",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "gpt-image-2",
    "image-generation",
    "openai-images",
    "text-to-image",
    "image-to-image"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vip164/dsh-image-gen.git"
  },
  "bugs": {
    "url": "https://github.com/vip164/dsh-image-gen/issues"
  },
  "homepage": "https://github.com/vip164/dsh-image-gen#readme",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2"
  },
  "license": "MIT",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node tests/plugin.test.mjs"
  }
}
